{
  "name": "rdna4-4k",
  "description": "High-end AMD RDNA 4 / RDNA 3 preset targeting 4K output with Wave32, copy-queue uploads, GPU upload heap, predictive PSOs, and native DXR 1.1 ray tracing.",
  "target_hardware": {
    "gpu_vram_gb_min": 16,
    "system_ram_gb_min": 32,
    "logical_cpus_min": 12
  },
  "env": {
    "VICTORY_OUTPUT": "3840x2160",
    "VICTORY_RDNA_WAVE32": "1",
    "VICTORY_UP_QUEUE": "1",
    "VICTORY_GPU_UPLOAD_HEAP": "1",
    "VICTORY_PREDICT_PSO": "1",
    "VICTORY_NATIVE_RT": "1",
    "VICTORY_BVH_BUILDER": "1",
    "VICTORY_NATIVE_RT_SUPPRESS_BUILDER": "1",
    "VICTORY_PIPELINE_BOOK": "1",
    "VICTORY_TEXTURE_NO_WAIT": "1",
    "VICTORY_RELAY": "2",
    "VICTORY_RELAY_COPY": "1",
    "VICTORY_WIDE_BACK": "1",
    "VICTORY_CARD_REHASH_RUNS": "1",
    "VICTORY_JOIN_COPIES": "1",
    "VICTORY_INDIRECT_WINDOW": "1",
    "VICTORY_CARD_STEPS": "2",
    "VICTORY_INDIRECT_BATCH": "2",
    "VICTORY_MAP_THREADS": "1",
    "VICTORY_TITLE_PRIORITIES": "0",
    "VICTORY_CARD_AWAKE": "1",
    "VICTORY_SHOW_AFTER": "1",
    "VICTORY_AMBIENT": "0.8",
    "VICTORY_AMBIENT_AIR": "1.5",
    "VICTORY_CARD_BUFFERS_MIN_KB": "64",
    "VICTORY_THIN": "1",
    "VICTORY_JOIN_PARTS": "8",
    "VICTORY_UPLOAD_AHEAD": "1",
    "VICTORY_LEVELS_ON_DEMAND": "1",
    "VICTORY_PORT_CBV": "1",
    "VICTORY_PORT_GUARD": "1",
    "VICTORY_PORT_JOURNAL": "1",
    "VICTORY_INPLACE": "2",
    "VICTORY_HEAP_WORKER": "1",
    "VICTORY_JOIN_BARRIERS": "1",
    "VICTORY_SCOPED_UAV_BARRIERS": "1",
    "VICTORY_LOG": "warn"
  },
  "keep": [
    "VICTORY_CONFIG",
    "VICTORY_GAME_DIR",
    "VICTORY_CACHE_DIR",
    "VICTORY_DATA_DIR"
  ]
}
