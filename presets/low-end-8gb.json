{
  "name": "low-end-8gb",
  "description": "Memory-constrained preset for 8 GB VRAM GPUs, <=16 GB system RAM, or <=8-thread CPUs targeting 720p output with reduced texture and shadow-window budgets.",
  "target_hardware": {
    "gpu_vram_gb_min": 8,
    "system_ram_gb_min": 8,
    "logical_cpus_min": 4
  },
  "env": {
    "VICTORY_LOW_END": "1",
    "VICTORY_OUTPUT": "1280x720",
    "VICTORY_TEXTURE_MAX": "512",
    "VICTORY_WINDOW_BUDGET_MB": "512",
    "VICTORY_UP_QUEUE": "0",
    "VICTORY_NATIVE_RT": "0",
    "VICTORY_BVH_BUILDER": "0",
    "VICTORY_PIPELINE_BOOK": "1",
    "VICTORY_LEVELS_ON_DEMAND": "1",
    "VICTORY_TEXTURE_NO_WAIT": "1",
    "VICTORY_RELAY": "2",
    "VICTORY_RELAY_COPY": "1",
    "VICTORY_WIDE_BACK": "1",
    "VICTORY_CARD_REHASH_RUNS": "1",
    "VICTORY_JOIN_COPIES": "1",
    "VICTORY_INDIRECT_WINDOW": "1",
    "VICTORY_CARD_STEPS": "2",
    "VICTORY_INDIRECT_BATCH": "2",
    "VICTORY_MAP_THREADS": "1",
    "VICTORY_TITLE_PRIORITIES": "0",
    "VICTORY_CARD_AWAKE": "1",
    "VICTORY_SHOW_AFTER": "1",
    "VICTORY_AMBIENT": "0.8",
    "VICTORY_AMBIENT_AIR": "1.5",
    "VICTORY_CARD_BUFFERS_MIN_KB": "64",
    "VICTORY_LOG": "warn"
  },
  "keep": [
    "VICTORY_CONFIG",
    "VICTORY_GAME_DIR",
    "VICTORY_CACHE_DIR",
    "VICTORY_DATA_DIR"
  ]
}
